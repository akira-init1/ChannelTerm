{
  "name": "@channelterm/electron",
  "version": "0.1.0",
  "private": true,
  "description": "Independent desktop client for an existing ChannelTerm Host",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "host:build": "node scripts/build-host.mjs",
    "files:build": "node scripts/build-host.mjs --files",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "check:desktop": "npm run check && npm run test:desktop && npm run test:desktop:dev",
    "test": "node scripts/build-fixture.mjs && tsx --test tests/*.test.ts",
    "test:desktop": "npm run build && node scripts/build-fixture.mjs && node --import tsx scripts/test-desktop.mjs",
    "test:desktop:dev": "node scripts/build-fixture.mjs && node --import tsx scripts/test-desktop.mjs --dev",
    "format": "prettier --write src tests scripts *.json *.ts *.html",
    "format:check": "prettier --check src tests scripts *.json *.ts *.html",
    "i18n:extract": "lingui extract --clean --workers 1",
    "i18n:compile": "lingui compile --workers 1",
    "i18n:check": "lingui compile --strict --workers 1",
    "pretypecheck": "npm run i18n:check",
    "pretest": "npm run i18n:check"
  },
  "dependencies": {
    "@lingui/core": "5.9.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "iconv-lite": "0.7.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@lingui/cli": "5.9.0",
    "@lingui/conf": "5.9.0",
    "@lingui/format-po": "5.9.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
