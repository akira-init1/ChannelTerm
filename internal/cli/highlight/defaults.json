  "rules": [
    {
      "pattern": "(?:^|[^A-Za-z0-9_])('[^'\\r\\n]*'|\"[^\"\\r\\n]*\"|“[^”\\r\\n]*”|‘[^’\\r\\n]*’)",
      "flags": "",
      "group": 1,
