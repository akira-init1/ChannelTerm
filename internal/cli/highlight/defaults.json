  "prompts": {
    "promptPattern": "^(?:\\[[0-9]{2}:[0-9]{2}:[0-9]{2}\\][ \\t]+)?(?:\\([^)\\r\\n]+\\)[ \\t]+)?([A-Za-z0-9_.-]+)@([A-Za-z0-9_.-]+):([^ \\t\\r\\n]+)([$#])[ \\t]*",
    "minimalShellPromptPattern": "^(?:\\[[0-9]{2}:[0-9]{2}:[0-9]{2}\\][ \\t]+)?(?:(?:ba)?sh-[0-9]+(?:\\.[0-9]+)*[$#]|/[ \\t]+#|\\[[A-Za-z0-9_.-]+@[A-Za-z0-9_.-]+[ \\t]+[^ \\t\\r\\n\\]]+\\][$#])(?:[ \\t]+|$)",
    "bootloaderPromptPattern": "^(?:=>|[A-Za-z0-9_.-]+>)[ \\t]+"
  }
}
